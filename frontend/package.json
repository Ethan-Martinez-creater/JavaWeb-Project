{
    "name": "eventflow-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.21.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview --host 0.0.0.0"
    },
    "dependencies": {
        "@vue/devtools-api": "8.2.1",
        "element-plus": "2.14.7",
        "pinia": "4.1.0",
        "qrcode": "1.5.4",
        "vue": "3.5.44",
        "vue-router": "5.4.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@types/node": "24.10.1",
        "@types/qrcode": "1.5.6",
        "@vitejs/plugin-vue": "6.0.10",
        "eslint": "9.39.2",
        "eslint-plugin-vue": "10.11.1",
        "globals": "16.5.0",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "vue-tsc": "3.3.13"
    }
}
