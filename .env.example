# Copy to .env and replace every placeholder before starting the local database.
DB_NAME=eventflow
DB_USERNAME=eventflow_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_URL=jdbc:mysql://127.0.0.1:3307/eventflow?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
JWT_SECRET=

# Optional dev-profile organizer seed values. Never use these in production.
DEV_ORGANIZER_EMAIL=
DEV_ORGANIZER_PASSWORD=
